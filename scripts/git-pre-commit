#!/usr/bin/env bash
# Repo-tracked pre-commit hook. Symlink into .git/hooks/pre-commit (see deploy note).
set -euo pipefail

if ! cargo fmt --all --check; then
    echo "pre-commit: rustfmt drift — run 'cargo fmt --all' and re-stage." >&2
    exit 1
fi

# Fast clippy on default features; the full powerset runs in CI.
# `--locked` like every other resolving cargo command in this repo: without it the hook that runs on
# EVERY commit is the one place a stale Cargo.lock gets silently regenerated — the drift the --locked
# policy exists to surface would be repaired underneath the commit that introduced it.
cargo clippy --locked --all-targets -- -D warnings
